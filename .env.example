# Copy this file to .env and fill in your values. Every setting has a sensible default in bot/config.py.

# === Telegram ===
# Bot token from @BotFather
BOT_TOKEN=123456:your-token-from-BotFather
# Group where finds are posted (usually starts with -100); more groups/channels can be added with /add_here
GROUP_CHAT_ID=-1001234567890
# Owner IDs, comma-separated (get yours with /myid). Owners can add more admins from the chat (/add_admin)
ADMIN_IDS=111111111,222222222
# Proxy for Telegram only, if api.telegram.org is not reachable directly, e.g. socks5://127.0.0.1:10808
TG_PROXY=

# === City ===
# Avito URL slug of the city (avito.ru/<slug>) and its Russian name; the city ID is looked up automatically
CITY=krasnodar
CITY_NAME=Краснодар

# === Avito access ===
# Mobile proxy for Avito (HTTP): http://user:password@host:port. Empty = direct connection
PROXY_URL=
# Proxy "change IP" link: called on a block, then the bot waits PROXY_ROTATE_WAIT seconds
PROXY_ROTATE_URL=
PROXY_ROTATE_WAIT=5
# Extra proxies tried in order if the main one is blocked
PROXY_LIST=
FREE_PROXIES=false
# false shows the Chromium window (handy on a desktop for logging in to Avito or solving a captcha)
HEADLESS=true

# === Search rhythm ===
# First results page via the lightweight JSON list every ~N seconds (randomised +/-25%)
FAST_JSON=true
FAST_JSON_SEC=7
# Full pass over pages 1..(1+DEEP_PAGES) every N minutes
CHECK_INTERVAL_MIN=10
CHECK_INTERVAL_MAX=10
DEEP_PAGES=4
# Night mode: first page every NIGHT_FAST_SEC seconds; the price base is refreshed in the background
NIGHT_HOURS=1-5
NIGHT_FAST_SEC=120
# After an Avito block, check N times less often for M minutes
BLOCK_SLOWDOWN_MIN=10
BLOCK_SLOWDOWN_FACTOR=2
# Also sweep the first page of N models per check (0 = off)
MODEL_SWEEP=0
# Only listings newer than N hours
MAX_AGE_HOURS=24

# === Posting ===
# Post immediately from the search card, verify the listing page afterwards (removed if it fails)
INSTANT_ALL=true
INSTANT_BELOW_MIN=true
# Post when price <= upper bound of the Avito price range minus MIN_PROFIT (RUB)
MIN_PROFIT=1000
MIN_PROFIT_BROKEN=1000
MAX_PHOTOS=4
# Listings that do not describe the condition: warn = post with a warning, skip = do not post
UNCLEAR_MODE=warn
# Refresh interval of the live status message (/status_here), seconds
LIVE_STATUS_SEC=10

# === Market price: Avito price estimator ===
MARKET_SOURCE=eval
AVITO_EVAL=true
AVITO_EVAL_PER_STEP=40

# === Captcha relay ===
CAPTCHA_RELAY=true
CAPTCHA_WAIT_MIN=10
CAPTCHA_COOLDOWN_MIN=60
# Web page that lets an admin solve a captcha in the bot's browser from a phone
REMOTE_ENABLED=true
REMOTE_HOST=0.0.0.0
REMOTE_PORT=8080
# Public address of that page, e.g. http://SERVER_IP:8080 (empty = local network address)
PUBLIC_URL=
# cloudflared = open a temporary public tunnel for the page (tools/cloudflared.exe)
TUNNEL=

# === Optional AI check of the description and photos ===
# none | openai (any OpenAI-compatible API) | ollama | claude
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# === Storage ===
DB_PATH=data/bot.sqlite3
